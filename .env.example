# Copy to .env -- `cp .env.example .env && docker compose up` is the whole setup.
# Every value below has a working local default; nothing here is required to
# boot the stack.

# --- Core ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Privacy ---
# Salt for hashing client IPs. The raw address is never stored.
# Generate a unique value before deploying anywhere real:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Staging and production refuse to boot with a placeholder value.
IP_HASH_SALT=local-dev-only-salt

# --- Ports (change if something already occupies them) ---
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Postgres ---
POSTGRES_USER=socialdl
POSTGRES_PASSWORD=socialdl
POSTGRES_DB=socialdl

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Platform toggles ---
# Snapchat is Spotlight-only with minimal metadata and unreliable Stories, so
# it ships off. While off it is omitted from the capability registry entirely,
# and the UI shows no Snapchat tab at all.
SNAPCHAT_ENABLED=false

# --- Extraction ---
# Hard ceiling on one yt-dlp invocation. Analyze normally takes 2-5s.
EXTRACTOR_TIMEOUT_SECONDS=45

# --- Rate limits (per IP) ---
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=200

# --- Optional AI layer (Tier 3) ---
# Leave blank to keep the AI features switched off. With no key the capability
# is hidden in the UI and the endpoint returns 503 with a clear message; the
# core downloader never depends on either service.
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Optional object storage (large files, Phase 3+) ---
# Unset locally: the worker uses the shared /tmp volume instead.
GCS_BUCKET=
